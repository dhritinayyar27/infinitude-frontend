# Same-origin API path. Vercel proxies to Render; Vite dev proxies to localhost:8080.
# The frontend never talks to Gemini directly and never holds GEMINI_API_KEY.
VITE_API_BASE_URL=/api

# Vercel function ONLY. Never prefix these with VITE_ or import them into src/.
# Same 32+ byte random secret as the backend EMAIL_RELAY_SECRET.
EMAIL_RELAY_SECRET=
GMAIL_USER=
# Gmail app password requires 2-Step Verification; not your normal Gmail password.
GMAIL_APP_PASSWORD=
# Upstash Redis REST credentials for durable, atomic replay protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
