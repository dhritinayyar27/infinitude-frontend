{
  "functions": {
    "api/send-otp.js": { "maxDuration": 30 }
  },
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/(.*)",
      "dest": "https://infinitude-backend.onrender.com/api/$1",
      "headers": { "Cache-Control": "no-store" }
    },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
